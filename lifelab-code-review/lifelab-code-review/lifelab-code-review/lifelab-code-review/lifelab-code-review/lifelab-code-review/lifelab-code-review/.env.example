# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=lifelab
DB_USERNAME=lifelab
DB_PASSWORD=change-me

# YouTube Data API v3
LIFELAB_YOUTUBE_API_KEY=your-youtube-data-api-key

# JWT
# Valid Base64 example that decodes to exactly 32 bytes.
# Replace this value for any real deployment.
LIFELAB_JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
LIFELAB_JWT_ISSUER=life-lab
LIFELAB_JWT_ACCESS_TOKEN_TTL=30m

# Daily Plan fallback timezone.
# The frontend normally sends the browser IANA timezone in X-Time-Zone.
# This value is used when that header is absent.
LIFELAB_DEFAULT_TIME_ZONE=Asia/Ho_Chi_Minh

# false for local HTTP development.
# Use true when deployed behind HTTPS.
LIFELAB_COOKIE_SECURE=false
