# Life Lab production environment
# Copy to .env.production and replace every secret/example value.

# PostgreSQL
DB_NAME=lifelab
DB_USERNAME=lifelab
DB_PASSWORD=replace-with-a-strong-database-password

# YouTube Data API v3
LIFELAB_YOUTUBE_API_KEY=replace-with-your-youtube-data-api-key

# JWT
# Must be valid Base64 and decode to at least 32 bytes.
LIFELAB_JWT_SECRET=replace-with-a-valid-base64-secret
LIFELAB_JWT_ISSUER=life-lab
LIFELAB_JWT_ACCESS_TOKEN_TTL=30m

# Daily Plan fallback timezone
LIFELAB_DEFAULT_TIME_ZONE=Asia/Ho_Chi_Minh

# Public Nginx ports
LIFELAB_HTTP_PORT=80
LIFELAB_HTTPS_PORT=443
