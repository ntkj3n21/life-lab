# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=lifelab
DB_USERNAME=lifelab
DB_PASSWORD=change-me

# YouTube Data API v3
LIFELAB_YOUTUBE_API_KEY=your-youtube-data-api-key

# JWT
# Must be valid Base64 and decode to at least 32 bytes.
LIFELAB_JWT_SECRET=replace-with-a-base64-secret

# false for local HTTP development.
# Use true when deployed behind HTTPS.
LIFELAB_COOKIE_SECURE=false